# ===== Endereço do site (sem barra no final) =====
NEXT_PUBLIC_SITE_URL=https://www.neostore.com.br

# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Mercado Pago (Suas integrações > Credenciais) =====
MP_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=

# ===== Melhor Envio (opcional: sem token, PAC e SEDEX não aparecem) =====
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_EMAIL=contato@neostore.com.br
MELHOR_ENVIO_SANDBOX=false
STORE_CEP=69151000
# Embalagem padrão (cm e kg)
PKG_HEIGHT_CM=15
PKG_WIDTH_CM=35
PKG_LENGTH_CM=40
PKG_WEIGHT_KG=1

# ===== Rotina diária que cancela pedidos abandonados (Vercel Cron) =====
# Crie uma senha longa e aleatória. A Vercel a envia sozinha ao chamar a rotina.
CRON_SECRET=

# ===== E-mails (Resend, opcional) =====
RESEND_API_KEY=
EMAIL_FROM=Neo Store <pedidos@neostore.com.br>
# Quem recebe os avisos de pedido (separe por vírgula)
ADMIN_NOTIFY_EMAILS=contato@neostore.com.br
